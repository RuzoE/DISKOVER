# ─────────────────────────────────────────────────────────────
# DSLE — plantilla de entorno de PRODUCCIÓN
#
#   cp .env.production.example .env
#   php artisan key:generate          # genera APP_KEY
#
# Nunca se versiona un .env real. Rellena APP_KEY y todas las contraseñas.
# ─────────────────────────────────────────────────────────────

APP_NAME="DISKOVER Smart Learning Ecosystem"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dsle.example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# Coste de bcrypt: 12 en producción.
BCRYPT_ROUNDS=12

# Log a stderr (lo recoge el orquestador) y a fichero rotado.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Base de datos — el host "db" es el servicio de docker-compose.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=diskover
DB_USERNAME=diskover
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Sesión, caché y cola sobre la base de datos: sin dependencia de Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Correo — configura un transporte real (SMTP/API) antes de usar recuperación
# de contraseña en producción.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dsle.example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Puerto HTTP publicado por el servicio "web" de docker-compose.
DSLE_HTTP_PORT=8080

# ── DSLE ────────────────────────────────────────────────────
# Asistente de IA (vacío -> StubAiProvider, sin red).
DSLE_AI_PROVIDER=
DSLE_AI_API_KEY=
DSLE_AI_BASE_URL=https://api.openai.com/v1
DSLE_AI_MODEL=gpt-4o-mini

# Administrador inicial del seeder. CAMBIA la contraseña tras el primer acceso.
DSLE_ADMIN_NAME="Administrador DSLE"
DSLE_ADMIN_EMAIL=admin@dsle.example.com
DSLE_ADMIN_PASSWORD=
DSLE_MAX_LOGIN_ATTEMPTS=5

# Seguridad HTTP (Fase 11). HSTS sólo se envía sobre HTTPS.
DSLE_HSTS_MAX_AGE=31536000

# Copias de seguridad (Fase 11). El scheduler lanza dsle:backup a diario.
DSLE_BACKUP_KEEP=7
DSLE_MYSQLDUMP_PATH=mysqldump

APP_NAME="DISKOVER Smart Learning Ecosystem"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diskover
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# DSLE — configuración específica del ecosistema
# Las claves de servicios externos (IA, Unity, etc.) se añadirán
# en su fase correspondiente. Nunca se versionan en el repositorio.
# ─────────────────────────────────────────────────────────────
# Asistente de IA (Fase 7). Sin proveedor -> StubAiProvider (responde sin red).
# provider: vacío | openai   (API compatible con OpenAI: OpenAI, Groq, OpenRouter, Ollama…)
DSLE_AI_PROVIDER=
DSLE_AI_API_KEY=
DSLE_AI_BASE_URL=https://api.openai.com/v1
DSLE_AI_MODEL=gpt-4o-mini
DSLE_AI_TIMEOUT=30
DSLE_AI_TEMPERATURE=0.4
DSLE_AI_MAX_HISTORY=12
DSLE_AI_RATE_LIMIT=12

# Seguridad / RBAC (Fase 1)
# Usuario administrador que crea el seeder. Cambia la contraseña tras el primer acceso.
DSLE_ADMIN_NAME="Administrador DSLE"
DSLE_ADMIN_EMAIL=admin@diskover.test
DSLE_ADMIN_PASSWORD=password
DSLE_MAX_LOGIN_ATTEMPTS=5
